# Copy to .env, generate unique secrets, and never commit .env.
NODE_ENV=production
PORT=3100
HOST=127.0.0.1
PUBLIC_URL=https://baliminsk.online
ADMIN_PASSWORD=CHANGE_TO_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
SCREEN_PASSWORD=CHANGE_TO_A_DIFFERENT_LONG_SCREEN_PASSWORD
SESSION_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
RETENTION_DAYS=7
MAX_PHOTOS_PER_GUEST=3
# 0 = unlimited by application count; actual disk/CPU/network limits still apply
MAX_PHOTOS_PER_EVENT=0
# 0 = no hourly request allowance
UPLOAD_REQUESTS_PER_HOUR=0
MIN_FREE_DISK_MB=512
MAX_ACTIVE_UPLOADS=12

# Authenticated bridge from existing BALI website backend to the club photo wall (minimum 32 random characters)
CONTEST_BRIDGE_KEY=
# External HTTPS endpoint on existing baliminsk.by backend. Never use localhost here; rewards are queued until configured
BALI_REWARDS_WEBHOOK_URL=
BALI_REWARDS_SECRET=
